# Supabase project settings — Project Settings > API in the Supabase dashboard.
# Never put the service_role key in frontend code. Only the anon (public) key belongs here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Reserved usernames barbers can't register (comma-separated). Also enforced server-side.
VITE_RESERVED_USERNAMES=admin,login,signup,onboarding,dashboard,settings,pricing,support,api,about,terms,privacy
